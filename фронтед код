<script>
const bar=document.createElement('span');
bar.style.cssText='position:fixed;right:12px;top:50%;transform:translateY(-50%);width:1px;height:115px;background:rgba(21,21,20,.12);z-index:35;transform-origin:top';
document.body.appendChild(bar);
function updateScroll(){
  const max=document.documentElement.scrollHeight-innerHeight;
  const p=max?scrollY/max:0;
  bar.style.background='linear-gradient(to bottom,var(--violet) '+(p*100)+'%,rgba(21,21,20,.12) '+(p*100)+'%)';
}
addEventListener('scroll',updateScroll,{passive:true});
updateScroll();

const topbar=document.getElementById('topbar');
addEventListener('scroll',()=>topbar.classList.toggle('scrolled',scrollY>24),{passive:true});

function updateClock(){
  const d=new Date();
  document.getElementById('clock').textContent=String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0');
}
updateClock();setInterval(updateClock,1000);

const menu=document.getElementById('menuBtn');
const nav=document.querySelector('.nav');
menu.addEventListener('click',()=>{
  document.body.classList.toggle('mobileNav');
  nav.style.display=document.body.classList.contains('mobileNav')?'flex':'';
  if(document.body.classList.contains('mobileNav')){
    nav.style.position='fixed';nav.style.inset='78px 18px auto 18px';
    nav.style.background='var(--bg)';nav.style.padding='24px';
    nav.style.border='1px solid var(--line)';
    nav.style.flexDirection='column';nav.style.gap='22px';nav.style.zIndex='70';
    nav.style.boxShadow='0 18px 50px rgba(0,0,0,.08)';
    menu.textContent='CLOSE ×';
  }else{
    nav.removeAttribute('style');menu.textContent='MENU +';
  }
});
[...document.querySelectorAll('.nav a')].forEach(a=>a.addEventListener('click',()=>{
  if(innerWidth<=980){nav.removeAttribute('style');document.body.classList.remove('mobileNav');menu.textContent='MENU +'}
}));
</script>
